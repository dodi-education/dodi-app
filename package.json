{
  "name": "dodi",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dodi/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db": "pnpm --filter @dodi/platform db:migrate",
    "parity:check": "pnpm --filter @dodi/parity check",
    "verify": "turbo run typecheck lint test && pnpm parity:check",
    "visual:parity": "pnpm --filter @dodi/visual-parity exec tsx src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.5.5",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "zod": "4.5.4"
    },
    "patchedDependencies": {
      "react-native-argon2@4.0.0": "patches/react-native-argon2@4.0.0.patch",
      "react-native-audio-api@0.13.6": "patches/react-native-audio-api@0.13.6.patch"
    }
  }
}
