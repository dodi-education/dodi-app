{
  "name": "dodi",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @dodi/web dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db": "set -a; [ -f ./.env ] && . ./.env; set +a; supabase --workdir platform"
  },
  "devDependencies": {
    "supabase": "^2.105.0",
    "turbo": "^2.5.5",
    "typescript": "^5"
  }
}
