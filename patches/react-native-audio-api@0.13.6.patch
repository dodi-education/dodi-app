+// dodi patch: an iOS app running on an Apple silicon Mac gets the macOS voice
+// processor, which only initializes when the engine's client-side input and
+// output formats match (else error -10875 and the engine never starts). With
+// voice processing on, the input node delivers 7 channels at 48 kHz while the
+// main mixer feeds the speaker in its default format (e.g. 2 channels at
+// 44.1 kHz). In that case the mic is tapped and the speaker is fed in one
+// matched format: mono float at the input node's sample rate. On a real iPhone
+// or iPad nothing changes. The helpers take no lock themselves: they are
+// called with _engineLock held (a recursive mutex).
+- (BOOL)usesMatchedVoiceProcessingFormat
+{
+  if (self.audioEngine == nil || ![[NSProcessInfo processInfo] isiOSAppOnMac]) {
+    return NO;
+  }
+
+  return [self.audioEngine.inputNode isVoiceProcessingEnabled];
+}
+
+- (AVAudioFormat *)matchedVoiceProcessingFormat
+{
+  AVAudioFormat *inputFormat = [self.audioEngine.inputNode outputFormatForBus:0];
+
+  if (inputFormat == nil || inputFormat.sampleRate <= 0) {
+    return nil;
+  }
+
+  return [[AVAudioFormat alloc] initStandardFormatWithSampleRate:inputFormat.sampleRate
+                                                        channels:1];
+}
+
+// dodi patch: runs before every prepare/start so a rebuilt engine gets it too.
+// It needs no sink attached: playback can start before the recorder, and the
+// speaker alone also needs the matched output format to start. A running
+// engine is never rewired (it was connected before it started).
+- (void)connectMatchedOutputFormatIfNeeded
+{
+  if (![self usesMatchedVoiceProcessingFormat] || [self.audioEngine isRunning]) {
+    return;
+  }
+
+  AVAudioFormat *matchedFormat = [self matchedVoiceProcessingFormat];
+
+  if (matchedFormat == nil) {
+    NSLog(@"AudioEngine: no input sample rate yet, output format left unmatched");
+    return;
+  }
+
+  [self.audioEngine connect:self.audioEngine.mainMixerNode
+                         to:self.audioEngine.outputNode
+                     format:matchedFormat];
+}
+
 - (AVAudioFormat *)liveInputFormat
 {
