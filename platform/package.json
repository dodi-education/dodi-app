  "scripts": {
    "dev": "next dev --experimental-https --experimental-https-key ../certs/dev-key.pem --experimental-https-cert ../certs/dev.pem -H 0.0.0.0 --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx db/migrate.ts",
    "db:reset": "tsx db/reset.ts",
    "db:seed": "tsx db/seed.ts",
    "db:codegen": "tsx db/codegen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@dodi/ai": "workspace:*",
    "@dodi/crypto": "workspace:*",
