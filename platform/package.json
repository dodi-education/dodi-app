    "@dodi/intl": "workspace:*",
    "@dodi/protocol": "workspace:*",
    "@dodi/types": "workspace:*",
    "@dodi/vault": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@react-email/components": "^1.0.12",
    "better-auth": "1.7.3",
    "kysely": "0.29.5",
    "next": "16.1.6",
    "pg": "8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.16.0",
    "zod": "^4.3.6"
