    "dev:redirect": "node scripts/http-redirect.mjs",
    "dev:full": "node scripts/http-redirect.mjs & next dev --experimental-https --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
