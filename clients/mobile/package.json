  "name": "@dodi/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "bundle:check": "expo export --platform android --platform ios --output-dir .expo-export --no-minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "eslint src",
    "build:android": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew assembleRelease",
    "build:android:aab": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew bundleRelease"
  },
