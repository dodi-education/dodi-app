{
  "name": "@dodi/mobile",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "bundle:check": "expo export --platform android --platform ios --output-dir .expo-export --no-minify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "expo lint",
    "build:android": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew assembleRelease",
    "build:android:aab": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@dodi/ai": "workspace:*",
    "@dodi/billing-contract": "workspace:*",
    "@dodi/client-state": "workspace:*",
    "@dodi/crypto": "workspace:*",
    "@dodi/design-tokens": "workspace:*",
    "@dodi/games": "workspace:*",
    "@dodi/intl": "workspace:*",
    "@dodi/protocol": "workspace:*",
    "@dodi/types": "workspace:*",
    "@dodi/vault": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@noble/hashes": "1.8.0",
    "@tabler/icons-react-native": "^3.48.0",
    "better-auth": "1.7.3",
    "expo": "~57.0.26",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-argon2": "^4.0.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.17",
    "use-intl": "^4.14.8",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.13",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
