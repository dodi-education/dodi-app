{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "APP_VARIANT": "development" }
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "simulator": {
      "extends": "production",
      "autoIncrement": false,
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "ios": { "simulator": false }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://platform.dodi.app",
        "EXPO_PUBLIC_DODI_AI_URL": "https://ai.dodi.app",
        "EXPO_PUBLIC_SITE_URL": "https://www.dodi.app",
        "EXPO_PUBLIC_CAPTCHA_ORIGIN": "https://app.dodi.app"
      }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6824571684" }
    }
  }
}
